# Copy these into Vercel Project Settings > Environment Variables.
# Never commit real secrets or upload a .env file to GitHub.

# Required: generate a random 32+ character secret, e.g. openssl rand -base64 48
SESSION_SECRET=replace-with-a-long-random-secret

# Required for chat, conversation history, and feedback
GROQ_API_KEY=replace-me
MONGODB_URI=mongodb+srv://replace-me
MONGODB_DB_NAME=ai_chat

# Required for Cloudflare image generation
CLOUDFLARE_ACCOUNT_ID=replace-me
CLOUDFLARE_API_TOKEN=replace-me

# Optional: turns on live web search; if omitted, chat still works without live search
TAVILY_API_KEY=replace-me

# Optional: durable image storage. If omitted, generated image is returned as a data URL.
# Create an R2 S3 API token (Access Key ID + Secret Access Key), not a normal Cloudflare API token.
R2_ACCESS_KEY_ID=replace-me
R2_SECRET_ACCESS_KEY=replace-me
R2_BUCKET_NAME=replace-me
R2_PUBLIC_BASE_URL=

# Optional: comma-separated allowed web origins. Default is * for the prototype.
CORS_ALLOWED_ORIGINS=*
